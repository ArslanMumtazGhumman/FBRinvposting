# For running the API on your machine. docker compose uses the .env.example at the repo root instead.

# --- required ---
NODE_ENV=production
PORT=3000
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production load this from KMS / Vault, never commit it.
VAULT_KEY_V1=
VAULT_ACTIVE_KEY=v1
SESSION_SECRET=
# Comma-separated origins allowed to call the API (your web app)
CORS_ORIGINS=https://app.rasid.pk

# PostgreSQL 16. Two roles:
#  - DATABASE_URL: the API login role. Must NOT own the tables or be a superuser, so row-level
#    security applies; the API refuses to start otherwise. `npm run db:migrate` creates it
#    (member of rasid_app) with this password if it does not exist yet.
#  - MIGRATION_DATABASE_URL: the table owner; used only by db:migrate and seed.
DATABASE_URL=postgres://rasid_api:change-me@localhost:5432/rasid
MIGRATION_DATABASE_URL=postgres://rasid_owner:change-me-too@localhost:5432/rasid

# Redis 7 for the posting queue (BullMQ). The API enqueues; `node dist/worker.js` posts to FBR.
# Use a Redis with persistence (AOF) and no eviction (maxmemory-policy noeviction).
REDIS_URL=redis://localhost:6379

# --- optional ---
DB_POOL_MAX=10
FBR_BASE_URL=https://gw.fbr.gov.pk
FBR_TIMEOUT_MS=30000
# Worker: jobs per process across all businesses, and FBR calls in flight per business (all processes)
POST_WORKER_CONCURRENCY=12
POST_CONCURRENCY_PER_BUSINESS=3
# How often a batch progress stream (SSE) checks the database
BATCH_POLL_MS=1000
