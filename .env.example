# Settings for `docker compose` (copy to .env next to docker-compose.yml).
# To run the API outside Docker, use rasid-api/.env.example instead.
#
# Generate each secret separately, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Passwords go into connection URLs, so keep them to letters and digits (hex is fine).

# --- database and queue ---
# Table owner (used only by the migrate service).
POSTGRES_PASSWORD=
# API/worker login role; migrate creates it with this password. Row-level security applies to it.
DB_APP_PASSWORD=
REDIS_PASSWORD=

# --- API and worker ---
NODE_ENV=production
PORT=3000
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production load this from KMS / Vault, never commit it.
VAULT_KEY_V1=
VAULT_ACTIVE_KEY=v1
SESSION_SECRET=
# The web app is served from the same origin (nginx proxies /api), so this only matters for other clients.
CORS_ORIGINS=https://app.rasid.pk

# --- optional ---
# Host port for the web container
WEB_PORT=8080
DB_POOL_MAX=10
FBR_BASE_URL=https://gw.fbr.gov.pk
FBR_TIMEOUT_MS=30000
POST_WORKER_CONCURRENCY=12
POST_CONCURRENCY_PER_BUSINESS=3
BATCH_POLL_MS=1000
# When the worker refreshes PRAL reference lists (cron, Pakistan time).
REFERENCE_REFRESH_CRON="30 2 * * *"
